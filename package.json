{
	"name": "emdash-plugin-zarinpal",
	"version": "0.1.1",
	"description": "Zarinpal payment gateway plugin for EmDash CMS on Cloudflare Workers and Node.js: payment links, server checkout, verified callbacks, reconciliation and an admin ledger.",
	"license": "MIT",
	"author": "Mehdi Taleghani",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/taleghanidev/emdash-plugin-zarinpal.git"
	},
	"homepage": "https://github.com/taleghanidev/emdash-plugin-zarinpal#readme",
	"bugs": {
		"url": "https://github.com/taleghanidev/emdash-plugin-zarinpal/issues"
	},
	"keywords": [
		"emdash",
		"emdash-plugin",
		"zarinpal",
		"payment",
		"cloudflare-workers",
		"iran"
	],
	"packageManager": "pnpm@11.8.0",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc",
		"examples",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=1.3.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "^1.3.1",
		"@emdash-cms/plugin-cli": "0.13.4",
		"@emdash-cms/plugin-test": "^0.2.10",
		"emdash": "^1.3.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	}
}
